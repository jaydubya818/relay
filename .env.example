# Required outside local development. Use long, random values.
RELAY_SESSION_SECRET=replace-with-at-least-32-random-characters
RELAY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# PostgreSQL and seeded dashboard account.
RELAY_DATABASE_URL=postgresql://relay:relay@127.0.0.1:5432/relay
RELAY_DATABASE_POOL_SIZE=10
RELAY_DATABASE_CONNECT_TIMEOUT_MS=5000
RELAY_DATABASE_IDLE_TIMEOUT_MS=30000
RELAY_ADMIN_EMAIL=admin@relay.local
RELAY_ADMIN_PASSWORD=change-me-before-sharing
RELAY_ALLOW_SIGNUP=false

# GitHub OAuth web flow. Callback: /api/connections/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo read:user

# Initial provider-neutral sandbox adapter.
RELAY_DOCKER_BIN=/Applications/Docker.app/Contents/Resources/bin/docker
RELAY_SANDBOX_IMAGE=alpine:3.20

# Public MCP URL shown in setup instructions.
NEXT_PUBLIC_RELAY_URL=http://localhost:3000
