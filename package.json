{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "A universal capability plane for AI agents.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "tsx scripts/reset-e2e.ts && next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "deploy:check": "tsx scripts/validate-private-preview.ts",
    "v2:frontier:check": "tsx scripts/verify-v2-frontier.ts",
    "qualify:google": "tsx scripts/qualify-google.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/e2e/**' --exclude '**/*.performance.test.ts'",
    "test:ci": "vitest run --fileParallelism=false --exclude 'tests/e2e/**' --exclude '**/*.performance.test.ts'",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:auth": "vitest run tests/auth",
    "test:database": "vitest run tests/database",
    "test:mcp": "vitest run tests/mcp",
    "test:oauth": "vitest run tests/oauth",
    "test:security": "vitest run tests/security",
    "test:v2:release": "vitest run tests/v2/release-qualification.test.ts --fileParallelism=false",
    "test:sandbox": "vitest run tests/sandbox",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "pnpm test:e2e:functional && pnpm test:e2e:performance",
    "test:e2e:functional": "playwright test",
    "test:e2e:performance": "playwright test --config=playwright.production.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed.ts",
    "qualify": "pnpm typecheck && pnpm lint && pnpm test:ci && pnpm test:performance && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.5.22",
    "pg": "^8.23.0",
    "playwright": "1.55.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.22",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
