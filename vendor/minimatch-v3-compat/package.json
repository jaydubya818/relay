{
  "name": "minimatch",
  "version": "11.0.4",
  "private": true,
  "description": "Default-export shim over patched minimatch 11.0.4 for eslint 9 CJS/ESM consumers (GHSA-g3hv-75wg-m249).",
  "main": "./index.cjs",
  "module": "./index.mjs",
